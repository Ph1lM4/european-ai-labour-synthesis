      }
    },
    "lens2_zone_heterogeneity": {
      "headline": "Beneath the uniform 80%-threshold refutation lies systematic A↔C heterogeneity (compounding vs unfillable).",
      "body": "Zone A (clerical/admin, ~25–30M EU workers) sees AI substitute 60–80% of tasks against only ~3.5M EU retirements by 2030 — a compounding mismatch of 5–10M mid-career workers displaced faster than retirement clears them. Zone C (healthcare/trades/care, ~90–100M EU workers) sees AI substitute only 5–15% of tasks against ~12M EU retirements by 2030 — an 8–12M unfillable shortage where AI cannot compensate. The buffer thesis fails uniformly at 80%, but the failure mode splits: Zone A overshoot (displacement > retirement attrition), Zone C undershoot (retirement attrition >> AI substitution capacity). Demographic load is therefore not orthogonal to AI exposure — it is anti-correlated zone-by-zone, country-by-country, with the largest 26% retirement_offset values (BG/EL/HR/LT/LV/MT/PL/PT/RO) still 54 pp below the 80% threshold. The orthogonality finding from Phase 1 stands at the aggregate, but Lens 2 is now a per-country object exposing the split.",
      "source_bundles": [
        "Phase 1",
        "Bundle P (L4 enrichment 2026-04-30)"
      ],
      "key_data_points": {
        "zone_a_employment_M": [
          25,
          30
        ],
        "zone_a_retirement_2030_M": 3.5,
        "zone_a_ai_displacement_M": [
          5,
          10
        ],
        "zone_c_employment_M": [
          90,
          100
        ],
        "zone_c_retirement_2030_M": 12,
        "zone_c_unfillable_2030_M": [
          8,
          12
        ],
        "zone_d_eu_ict_gap_2030_M": 10,
        "max_retirement_offset_pct": 26.4,
        "threshold_pct": 80,
        "countries_with_retirement_offset_data": 32,
        "countries_with_working_age_2050_explicit": 9
      },
      "knock_on": [
        "Executive §2 (orthogonality finding gains zone-bifurcation paragraph)",
        "Executive §4 (per-country Lens 2 narrative now resolvable)",
        "Executive §5 (limits — Lens 2 single-string caveat retired)",
        "One-Pager finding 2 (uniform refutation + zone bifurcation)",
        "Specialist Appendix §4.2 (orthogonality result sharpened, not contradicted)",
        "Einfache versions (Zone A vs Zone C bifurcation accessible at lay-language level)",
        "Glossary (Zone A/B/C/D labels; retirement_offset definition; 80% threshold derivation)",
        "Bundle N3 Long-Read structural-bias section",
        "Bundle O countries.html drilldowns (per-country Lens 2 object render)"
      ]
    },
    "regulatory_asymmetry": {
      "summary": "Layer 1's dual scoring (EU regulated_score vs uk_regulated_score) quantifies regulatory asymmetry across all 36 countries. The EU-vs-UK delta (avg 1.2 vs 0.5 friction points per occupation) translates, when weighted by each country's labour mix, into an asymmetry score that ranges across EU-27 + EFTA above the UK baseline. The 8 squeeze-flagged Lens 4 countries (BE, DE, DK, FI, FR, NL, NO, SE) sit at the top of the regulated-absorption-friction distribution: their high-exposure occupations are also the most regulated, compounding the squeeze the binary flag identifies.",
      "_provenance": {
        "source_layer": "L1",
        "source_data": "scores.json + uk_scores.json + site/data.json",
        "bundle": "Q"
      }
    }
