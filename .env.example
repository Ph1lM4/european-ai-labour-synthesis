# Environment variables for resources.html lead-gen flow.
#
# Usage:
#   1. Copy this file to .env: `cp .env.example .env`
#   2. Fill in real values from your Scaleway + MailerLite accounts
#   3. The .env file is gitignored and never committed
#   4. For production, set the same vars in the Netlify dashboard:
#      Site Settings -> Build & deploy -> Environment
#
# Used by:
#   - scripts/upload-pdfs-to-scaleway.sh (reads .env directly)
#   - netlify/functions/subscribe.mjs (via Netlify env at runtime, via `netlify dev` locally)
#
# Full setup walkthrough: internal/B2-deployment-notes.md


# ─────────────────────────────────────────────────────────────
# Scaleway Object Storage (PDF host)
# Console: https://console.scaleway.com/object-storage/
# ─────────────────────────────────────────────────────────────

# IAM API key (Object Storage permissions on the bucket's project)
# IAM -> API keys -> Generate API key
SCW_ACCESS_KEY=SCWXXXXXXXXXXXXXXXXX
SCW_SECRET_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Region + S3-compatible endpoint (Paris)
SCW_REGION=fr-par
SCW_ENDPOINT=https://s3.fr-par.scw.cloud

# Bucket name (private, fr-par, created in your Scaleway console)
SCW_BUCKET=nexalps-layer-6-private

# Object keys (filenames inside the bucket — these match the uploaded PDFs)
SCW_KEY_VISUAL_READ=layer-6-deliverable-visual-read.pdf
SCW_KEY_LONG_READ=layer-6-deliverable-long-read.pdf
SCW_KEY_EXECUTIVE=layer-6-deliverable-executive.pdf
SCW_KEY_SPECIALIST=layer-6-deliverable-specialist.pdf


# ─────────────────────────────────────────────────────────────
# MailerLite (subscriber list + email automation)
# Dashboard: https://dashboard.mailerlite.com/
# ─────────────────────────────────────────────────────────────

# API token (Account settings -> Developers -> Generate new token)
MAILERLITE_API_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9...

# Main group ID — "Documents downloaders" or similar
# Get from the URL when you open the group in the MailerLite UI
MAILERLITE_GROUP_ID=000000000000000000

# Per-PDF intent groups (tagged only when the user checks the interest box)
# Create 4 groups in MailerLite: pdf-visual-read, pdf-long-read, pdf-executive, pdf-specialist
MAILERLITE_TAG_VISUAL_READ=000000000000000000
MAILERLITE_TAG_LONG_READ=000000000000000000
MAILERLITE_TAG_EXECUTIVE=000000000000000000
MAILERLITE_TAG_SPECIALIST=000000000000000000
